DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-real-environments-this-is-only-for-local-dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=integra_afc
# Not the postgres container's bootstrap/superuser role (that's still
# "integra" — see docker/postgres/init-role-hardening.sql). RLS is a
# no-op for a superuser connection regardless of FORCE ROW LEVEL
# SECURITY, so the app connects as this separate, ordinary role instead.
POSTGRES_USER=integra_app
POSTGRES_PASSWORD=integra_app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202

# Phase 5 Slice 2 (docs/specs/5-payments-wallet-ledger.md) — no defaults,
# every real environment must set these explicitly.
PAYSTACK_SECRET_KEY=sk_test_0fab9f136abd0d78b3230a2900f8ceac1705d3f5
# Paystack signs webhooks with the same secret used for API calls (no
# distinct "webhook secret" exists in their product) — set both to the
# same value.
PAYSTACK_WEBHOOK_SECRET=sk_test_0fab9f136abd0d78b3230a2900f8ceac1705d3f5
# Not a technical default — the real commission rate is a product/
# finance decision, not something to inherit silently.
INTEGRA_COMMISSION_RATE_PERCENT=replace_with_the_real_rate

# Phase 6 Slice 1 (docs/specs/6-ticketing.md, docs/adr/0005) — no
# defaults in real environments; local/ci settings modules carry their
# own fixed insecure test keypair instead of needing this file.
# JSON object: {"<kid>": "<base64 Ed25519 private key>", ...}.
TICKET_SIGNING_KEYS=replace_with_a_real_json_keymap
TICKET_SIGNING_ACTIVE_KID=replace_with_the_active_kid
